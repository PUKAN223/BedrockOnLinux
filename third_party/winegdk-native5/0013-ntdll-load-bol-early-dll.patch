From: BedrockOnLinux contributors
Subject: [PATCH] ntdll: load BOL_EARLY_DLL before the main entry point

LeviLamina's PreLoader must be initialized during process startup.  Loading it
through BedrockOnLinux's normal injector happens after Minecraft has entered
its startup path and cannot establish the hooks LeviLamina needs.

The launcher sets BOL_EARLY_DLL only for an opted-in Minecraft launch.  This
patch reads that single variable after the ntdll and kernel32 process attaches,
but before the mapped main image's dependencies and entry point are attached.
An absent variable is a no-op, so ordinary Wine applications retain the normal
loader behaviour.  A load failure terminates the process before the game starts
and records both NTSTATUS and its Win32 error mapping in the Wine log.
---
diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -4415,6 +4415,30 @@ static void release_address_space(void)
 #endif
 }
 
+
+/******************************************************************
+ *              load_bol_early_dll
+ *
+ * BOL_EARLY_DLL is set only by BedrockOnLinux for its Minecraft launch. Load
+ * it after ntdll and kernel32 are attached, but before the main image's
+ * dependency graph and entry point are initialized. This is deliberately not
+ * a general-purpose preload facility.
+ */
+static NTSTATUS load_bol_early_dll(void)
+{
+    UNICODE_STRING path;
+    HMODULE module;
+    NTSTATUS status;
+
+    if ((status = get_env_var( L"BOL_EARLY_DLL", 0, &path )))
+        return status == STATUS_VARIABLE_NOT_FOUND ? STATUS_SUCCESS : status;
+
+    status = LdrLoadDll( NULL, 0, &path, &module );
+    RtlFreeHeap( GetProcessHeap(), 0, path.Buffer );
+    return status;
+}
+
+
 /******************************************************************
  *		loader_init
  *
@@ -4547,6 +4585,13 @@ void loader_init( CONTEXT *context, void **entry )
             NtTerminateProcess( GetCurrentProcess(), status );
         }
 
+        if ((status = load_bol_early_dll()))
+        {
+            ERR( "could not load BOL_EARLY_DLL, status %lx (Win32 error %lu)\\n",
+                 status, RtlNtStatusToDosError( status ) );
+            NtTerminateProcess( GetCurrentProcess(), status );
+        }
+
         if ((status = walk_node_dependencies( wm->ldr.DdagNode, context, process_attach )))
         {
             if (last_failed_modref)
